# Optional: copy to .env.local. Membership-free defaults work without this file.
# No credentials belong in NEXT_PUBLIC_ variables.

# Compatibility names retained from Parallax. These are Hacksfield's defaults.
PARALLAX_PERSONAL_MODE=1
NEXT_PUBLIC_PARALLAX_PERSONAL_MODE=1
NEXT_PUBLIC_PARALLAX_PROVIDER=byteplus
PARALLAX_DEMO_BILLING=off

# Shared rolling 24-hour media budget; zero pauses new paid work.
BYTEPLUS_DAILY_BUDGET_USD=5
# PARALLAX_DATA_DIR=/absolute/path/to/private/data

# Prefer saving keys locally at http://127.0.0.1:3000/settings/provider.
# BYTEPLUS_API_KEY=                 # ModelArk platform key, not Coding Plan.
# BYTEPLUS_SPEECH_API_KEY=          # Separate spoken-audio credentials.
# BYTEPLUS_SPEECH_APP_ID=           # Only for a legacy Speech Access Token.
# BYTEPLUS_AUDIO_API_KEY=           # Modern Speech key for Audio 1.0.
# DECART_API_KEY=                   # Decart developer platform key.

# Direct providers require a configured key. Explicit mock mode makes local samples.
# BYTEPLUS_MODE=mock
# DECART_MODE=mock

# Private TOS storage for BytePlus video uploads and temporary chat downloads.
# Use a bucket with one-day cleanup and a key restricted to its parallax/ objects.
# BYTEPLUS_TOS_BUCKET=
# BYTEPLUS_TOS_ACCESS_KEY_ID=
# BYTEPLUS_TOS_SECRET_ACCESS_KEY=

# Optional ChatGPT-subscription assistant through an existing local Hermes sign-in.
# PARALLAX_ASSISTANT_PROVIDER=codex-subscription
# PARALLAX_HERMES_ROOT=/absolute/path/to/hermes-agent
# PARALLAX_HERMES_HOME=/absolute/path/to/hermes-profile
# PARALLAX_COPY_MODEL=gpt-6.1-terra
# Subscription limits apply. BytePlus and Decart API usage remains separate.

# Optional upstream gateway; choosing it requires a matching browser rebuild.
# NEXT_PUBLIC_PARALLAX_PROVIDER=treg
# TREG_TOKEN=
# TREG_MODE=live
TREG_DAILY_BUDGET_USD=5

# Optional upstream integrations: none are enabled or authenticated by this example.
# SUPER_MODE=live
# ANTHROPIC_API_KEY=
# ORGO_API_KEY=
# COMPOSIO_API_KEY=
# SUPER_ENGINE=hermes
# HERMES_URL=http://127.0.0.1:8642
# HERMES_API_KEY_FILE=/absolute/path/to/hermes-api.key
# SUPER_ENGINE_TOKEN_FILE=/absolute/path/to/engine.token
# SUPER_ENGINE_NAME=Hermes

# Optional public demo content. Leave unset for an empty local library.
# PARALLAX_DEMO_SEED=1
# COOKIE_SECURE=1                  # Required when deliberately serving over HTTPS.
